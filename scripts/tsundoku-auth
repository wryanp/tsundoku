#!/usr/bin/env node
//
// tsundoku-auth — OAuth 2.0 Authorization Code + PKCE for a public client
// (no client secret, ever: this ships inside a plugin, not a backend).
// The system browser does the authenticating; this process only shuttles
// the loopback redirect and the token exchange, so it must never prompt
// for or accept a password itself.
//
// Usage: tsundoku-auth <status|connect|token|disconnect> <provider>

var crypto = require("crypto")
var fs = require("fs")
var path = require("path")
var os = require("os")
var http = require("http")
var spawn = require("child_process").spawn

var Providers = require("../Providers.js")

// ---- config resolution --------------------------------------------------

function dataDir() {
  return process.env.TSUNDOKU_DATA_DIR || path.join(os.homedir(), ".local", "share", "tsundoku")
}

function authDir() {
  return path.join(dataDir(), "auth")
}

function tokenFilePath(provider) {
  return path.join(authDir(), provider + ".json")
}

function clientsOverlayPath() {
  return path.join(authDir(), "clients.json")
}

// A missing or unparsable overlay is not an error — it just means no
// install-specific clientId has been supplied yet.
function readClientsOverlay() {
  try {
    var parsed = JSON.parse(fs.readFileSync(clientsOverlayPath(), "utf8"))
    return parsed && typeof parsed === "object" ? parsed : {}
  } catch (e) {
    return {}
  }
}

// No auth block registered for this provider at all is unconfigured,
// full stop — the overlay only ever fills in fields on top of a provider
// the registry already knows how to talk OAuth to.
function effectiveConfig(provider) {
  var base = Providers.authConfig(provider)
  if (!base) return null
  var overlay = readClientsOverlay()[provider] || {}
  var merged = {}
  var key
  for (key in base) merged[key] = base[key]
  for (key in overlay) merged[key] = overlay[key]
  return merged
}

function isConfigured(cfg) {
  return !!(cfg && cfg.clientId)
}

// ---- PKCE -----------------------------------------------------------------

function base64url(buf) {
  return buf.toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
}

function generatePkce() {
  var verifier = base64url(crypto.randomBytes(32))
  var challenge = base64url(crypto.createHash("sha256").update(verifier).digest())
  var state = base64url(crypto.randomBytes(16))
  return { verifier: verifier, challenge: challenge, state: state }
}

// ---- token file I/O ---------------------------------------------------

function readTokenFile(provider) {
  try {
    var parsed = JSON.parse(fs.readFileSync(tokenFilePath(provider), "utf8"))
    return parsed && typeof parsed === "object" ? parsed : null
  } catch (e) {
    return null
  }
}

// The mode option on writeFileSync only applies when the file is created,
// so a rewrite of an existing token file needs the explicit chmod too.
function writeTokenFile(provider, record) {
  fs.mkdirSync(authDir(), { recursive: true, mode: 0o700 })
  var file = tokenFilePath(provider)
  fs.writeFileSync(file, JSON.stringify(record), { mode: 0o600 })
  fs.chmodSync(file, 0o600)
  return record
}

function deleteTokenFile(provider) {
  try {
    fs.unlinkSync(tokenFilePath(provider))
  } catch (e) {
    // Already gone — disconnecting twice is a no-op, not an error.
  }
}

function buildTokenRecord(provider, tokenJson, fallback) {
  var now = new Date()
  var expiresAt = new Date(now.getTime() + (Number(tokenJson.expires_in) || 0) * 1000)
  return {
    provider: provider,
    accessToken: tokenJson.access_token,
    // A refresh response is allowed to omit refresh_token, meaning "the
    // old one is still valid" — only present when there's nothing to
    // fall back to (the initial exchange).
    refreshToken: tokenJson.refresh_token || (fallback && fallback.refreshToken),
    tokenType: tokenJson.token_type || (fallback && fallback.tokenType),
    scope: tokenJson.scope || (fallback && fallback.scope),
    expiresAt: expiresAt.toISOString(),
    obtainedAt: now.toISOString()
  }
}

// ---- HTTP helpers -------------------------------------------------------

function postForm(endpoint, body) {
  var controller = new AbortController()
  var timer = setTimeout(function() { controller.abort() }, 10000)
  return fetch(endpoint, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: body.toString(),
    signal: controller.signal
  }).then(function(res) {
    return res.text().then(function(text) {
      var json = null
      try {
        json = JSON.parse(text)
      } catch (e) {
        json = null
      }
      return { ok: res.ok, status: res.status, json: json }
    })
  }).finally(function() {
    clearTimeout(timer)
  })
}

function buildAuthorizeUrl(cfg, redirectUri, pkce) {
  var url = new URL(cfg.authEndpoint)
  url.searchParams.set("response_type", "code")
  url.searchParams.set("client_id", cfg.clientId)
  url.searchParams.set("redirect_uri", redirectUri)
  url.searchParams.set("state", pkce.state)
  url.searchParams.set("code_challenge_method", "S256")
  url.searchParams.set("code_challenge", pkce.challenge)
  if (cfg.scopes && cfg.scopes.length) {
    url.searchParams.set("scope", cfg.scopes.join(" "))
  }
  return url.toString()
}

async function exchangeCode(cfg, code, redirectUri, pkce) {
  var body = new URLSearchParams()
  body.set("grant_type", "authorization_code")
  body.set("code", code)
  body.set("redirect_uri", redirectUri)
  body.set("client_id", cfg.clientId)
  body.set("code_verifier", pkce.verifier)

  var result = await postForm(cfg.tokenEndpoint, body)
  if (!result.ok || !result.json || !result.json.access_token) {
    throw new Error("exchange-failed")
  }
  return result.json
}

// ---- callback pages -------------------------------------------------------

function escapeHtml(s) {
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
}

function successHtml(provider) {
  return "<!doctype html><html><body><p>Connected to " + escapeHtml(provider) + " — you can close this tab.</p></body></html>"
}

function deniedHtml() {
  return "<!doctype html><html><body><p>Authorization was declined. You can close this tab.</p></body></html>"
}

function failureHtml() {
  return "<!doctype html><html><body><p>Something went wrong finishing sign-in. You can close this tab.</p></body></html>"
}

// ---- commands ---------------------------------------------------------

function statusCommand(provider) {
  // Token file presence wins over unconfigured: an install that later
  // loses its clients.json overlay should still read as connected.
  if (readTokenFile(provider)) {
    return { provider: provider, state: "connected" }
  }
  if (!isConfigured(effectiveConfig(provider))) {
    return { provider: provider, state: "unconfigured" }
  }
  return { provider: provider, state: "disconnected" }
}

function disconnectCommand(provider) {
  deleteTokenFile(provider)
  return { provider: provider, state: "disconnected" }
}

async function tokenCommand(provider) {
  var tokenRecord = readTokenFile(provider)
  if (!tokenRecord) {
    return { provider: provider, state: "disconnected" }
  }

  var expiresAtMs = Date.parse(tokenRecord.expiresAt)
  if (!isNaN(expiresAtMs) && expiresAtMs - Date.now() > 60000) {
    return { provider: provider, state: "connected", accessToken: tokenRecord.accessToken }
  }

  var cfg = effectiveConfig(provider) || {}
  var stillValid = !isNaN(expiresAtMs) && expiresAtMs > Date.now()

  var body = new URLSearchParams()
  body.set("grant_type", "refresh_token")
  body.set("refresh_token", tokenRecord.refreshToken)
  body.set("client_id", cfg.clientId || "")

  var result
  try {
    result = await postForm(cfg.tokenEndpoint, body)
  } catch (e) {
    return stillValid
      ? { provider: provider, state: "connected", accessToken: tokenRecord.accessToken }
      : { provider: provider, state: "error", error: "refresh-failed" }
  }

  // A revoked/expired refresh token is a permanent failure — no amount of
  // retrying fixes it, so the stored token is discarded outright rather
  // than falling back to it like the other failure branches below do.
  if (result.status === 400 || result.status === 401) {
    deleteTokenFile(provider)
    return { provider: provider, state: "disconnected" }
  }

  if (!result.ok || !result.json || !result.json.access_token) {
    return stillValid
      ? { provider: provider, state: "connected", accessToken: tokenRecord.accessToken }
      : { provider: provider, state: "error", error: "refresh-failed" }
  }

  var record = buildTokenRecord(provider, result.json, tokenRecord)
  writeTokenFile(provider, record)
  return { provider: provider, state: "connected", accessToken: record.accessToken }
}

function connectCommand(provider) {
  var cfg = effectiveConfig(provider)
  if (!isConfigured(cfg)) {
    return Promise.resolve({ provider: provider, state: "error", error: "unconfigured" })
  }

  var pkce = generatePkce()
  var redirectPath = cfg.redirectPath || "/callback"

  return new Promise(function(resolve) {
    var settled = false
    var timer = null
    var redirectUri = null

    function finish(result) {
      if (settled) return
      settled = true
      if (timer) clearTimeout(timer)
      if (server.listening) server.close()
      if (typeof server.closeAllConnections === "function") server.closeAllConnections()
      resolve(result)
    }

    var server = http.createServer(function(req, res) {
      var url = new URL(req.url, "http://127.0.0.1")

      // Browsers probe /favicon.ico on their own; that must never
      // conclude a flow that's still waiting on the real redirect.
      if (url.pathname !== redirectPath) {
        res.writeHead(404)
        res.end()
        return
      }

      // An injected or replayed callback with the wrong state must not
      // kill a legitimate flow still in progress.
      if (url.searchParams.get("state") !== pkce.state) {
        res.writeHead(400)
        res.end()
        return
      }

      if (url.searchParams.get("error")) {
        res.writeHead(200, { "Content-Type": "text/html" })
        res.end(deniedHtml(), function() {
          finish({ provider: provider, state: "error", error: "denied" })
        })
        return
      }

      var code = url.searchParams.get("code")
      if (!code) {
        res.writeHead(400)
        res.end()
        return
      }

      exchangeCode(cfg, code, redirectUri, pkce).then(function(tokenJson) {
        writeTokenFile(provider, buildTokenRecord(provider, tokenJson, null))
        res.writeHead(200, { "Content-Type": "text/html" })
        res.end(successHtml(provider), function() {
          finish({ provider: provider, state: "connected" })
        })
      }, function() {
        res.writeHead(502, { "Content-Type": "text/html" })
        res.end(failureHtml(), function() {
          finish({ provider: provider, state: "error", error: "exchange-failed" })
        })
      })
    })

    server.on("error", function(err) {
      if (err.code === "EADDRINUSE") {
        finish({ provider: provider, state: "error", error: "port-busy" })
      } else {
        finish({ provider: provider, state: "error", error: "exchange-failed" })
      }
    })

    server.listen(cfg.redirectPort || 0, "127.0.0.1", function() {
      redirectUri = "http://127.0.0.1:" + server.address().port + redirectPath
      var authorizeUrl = buildAuthorizeUrl(cfg, redirectUri, pkce)

      timer = setTimeout(function() {
        finish({ provider: provider, state: "error", error: "timeout" })
      }, Number(process.env.TSUNDOKU_AUTH_TIMEOUT_MS) || 300000)

      // TSUNDOKU_AUTH_NO_BROWSER is the automated-test hook: stdout stays
      // reserved for the single result line, so the URL a real run would
      // hand to xdg-open goes to stderr instead.
      if (process.env.TSUNDOKU_AUTH_NO_BROWSER) {
        process.stderr.write("authorize_url=" + authorizeUrl + "\n")
      } else {
        try {
          spawn("xdg-open", [authorizeUrl], { detached: true, stdio: "ignore" }).unref()
        } catch (e) {
          // A missing xdg-open degrades to a timeout, same as the user
          // never completing the flow — it isn't this process's job to
          // surface "no browser handler" as a distinct error.
        }
      }
    })
  })
}

module.exports = {
  dataDir: dataDir,
  authDir: authDir,
  tokenFilePath: tokenFilePath,
  clientsOverlayPath: clientsOverlayPath,
  effectiveConfig: effectiveConfig,
  isConfigured: isConfigured,
  base64url: base64url,
  generatePkce: generatePkce,
  buildAuthorizeUrl: buildAuthorizeUrl,
  statusCommand: statusCommand,
  connectCommand: connectCommand,
  tokenCommand: tokenCommand,
  disconnectCommand: disconnectCommand
}

async function main() {
  var args = process.argv.slice(2)
  var command = args[0]
  var provider = args[1]
  var validCommands = { status: true, connect: true, token: true, disconnect: true }

  if (!validCommands[command] || !provider) {
    process.stderr.write("Usage: tsundoku-auth <status|connect|token|disconnect> <provider>\n")
    process.exitCode = 2
    return
  }

  var result
  if (command === "status") {
    result = statusCommand(provider)
  } else if (command === "disconnect") {
    result = disconnectCommand(provider)
  } else if (command === "connect") {
    result = await connectCommand(provider)
  } else {
    result = await tokenCommand(provider)
  }

  process.stdout.write(JSON.stringify(result) + "\n")
}

if (require.main === module) {
  main().catch(function(err) {
    process.stderr.write(String((err && err.stack) || err) + "\n")
    process.exitCode = 1
  })
}
