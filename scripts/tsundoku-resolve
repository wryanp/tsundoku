#!/bin/bash
#
# tsundoku-resolve — turn a saved URL into title/author/thumbnail metadata.
#
# Called once per saved item by the QML service. Tries three tiers, each a
# fallback for the one before it: oEmbed (if the caller hands us a
# provider's endpoint), OpenGraph scraping of the page itself, and finally
# a bare hostname title. Whatever happens, this always exits 0 and prints
# exactly one line of JSON — a resolution failure is not an error to the
# caller (that's the whole point of having a fallback tier), only a
# malformed invocation is.
#
# Usage: tsundoku-resolve --thumbs-dir DIR [--oembed ENDPOINT_URL] <url>

UA="tsundoku/0.3 (+https://github.com/wryanp/tsundoku)"
# No -L here: redirects are followed manually (see fetch_capped and
# download_thumbnail) so every hop is re-vetted with url_resolve_pin, and
# fetched only at the address that check vetted.
CURL_OPTS=(--max-time 5 -sS --fail -A "$UA")
MAX_REDIRECTS=5

# --- network safety --------------------------------------------------------

# A saved link is attacker-chosen input, so resolution must never become a
# way to probe this machine or its LAN: every URL this script fetches —
# page, oEmbed endpoint, thumbnail, and each redirect hop — has to pass
# url_resolve_pin first, and the address it vetted is then pinned into the
# curl invocation with --resolve. Checking without pinning would leave a
# DNS rebinding hole: curl re-resolves the name itself, and a hostile DNS
# server can answer the validation lookup with a public address and the
# transfer's lookup with a loopback or LAN one. --resolve forces the
# connection to the exact vetted address while curl still uses the original
# hostname for the Host header, TLS SNI, and certificate verification.

# True when $1 (an IPv4 or IPv6 literal) is a plausibly public address.
ip_is_public() {
  local ip="${1,,}"
  # IPv6-mapped IPv4 is judged as its IPv4 part.
  ip="${ip#::ffff:}"
  if [[ "$ip" == *:* ]]; then
    case "$ip" in
      :: | ::1) return 1 ;;                  # unspecified, loopback
      fc* | fd*) return 1 ;;                 # unique local fc00::/7
      fe8* | fe9* | fea* | feb*) return 1 ;; # link-local fe80::/10
    esac
    return 0
  fi
  local a b c d o
  IFS=. read -r a b c d <<<"$ip"
  [[ -n "$a" && -n "$b" && -n "$c" && -n "$d" ]] || return 1
  [[ "$a$b$c$d" =~ ^[0-9]+$ ]] || return 1
  # Canonical dotted-quad only: a leading zero means different parsers
  # disagree on the value (glibc reads 010.0.0.1 as octal 8.0.0.1, others
  # as decimal 10.0.0.1), so such forms are rejected, not interpreted.
  for o in "$a" "$b" "$c" "$d"; do
    [[ "$o" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    ((o <= 255)) || return 1
  done
  ((a == 0 || a == 10 || a == 127)) && return 1  # "this" net, private, loopback
  ((a == 100 && b >= 64 && b <= 127)) && return 1 # CGNAT 100.64/10
  ((a == 169 && b == 254)) && return 1            # link-local
  ((a == 172 && b >= 16 && b <= 31)) && return 1  # private
  ((a == 192 && b == 168)) && return 1            # private
  ((a >= 224)) && return 1                        # multicast/reserved/broadcast
  return 0
}

# True when $1 is a valid TCP port with no ambiguity (no leading zeros).
port_ok() {
  [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]] && (($1 <= 65535))
}

# Validates that $1 is a well-formed http(s) URL whose host is public, and
# arranges for curl to connect to the exact address that was vetted. On
# success, sets the global resolve_opts array to the --resolve arguments
# that pin the vetted address (empty for IP-literal hosts, which involve no
# DNS lookup to rebind) and returns 0.
#
# Rejected outright, rather than interpreted: userinfo (http://a@b/ tricks
# naive parsers), a second colon in an unbracketed authority, invalid or
# zero-padded ports, unclosed brackets, hosts outside [A-Za-z0-9.-], and
# numeric-looking hosts (only digits, dots, x/X) that aren't a canonical
# dotted quad — glibc, curl, and browsers disagree on octal/hex/integer
# IPv4 forms, so no single interpretation of them can be trusted.
#
# For DNS-named hosts every resolved address must be public (one bad
# address rejects the URL), and one vetted address — IPv4 preferred — is
# pinned for the transfer.
url_resolve_pin() {
  local u="$1" authority host port after addrs ip pin=""
  resolve_opts=()
  case "$u" in
    http://*) port=80 ;;
    https://*) port=443 ;;
    *) return 1 ;;
  esac
  authority="${u#*://}"
  authority="${authority%%[/?#]*}"
  [[ -n "$authority" && "$authority" != *@* ]] || return 1
  if [[ "$authority" == \[* ]]; then
    # Bracketed IPv6 literal, optionally followed by :port.
    host="${authority#\[}"
    [[ "$host" == *\]* ]] || return 1
    after="${host#*\]}"
    host="${host%%\]*}"
    case "$after" in
      "") ;;
      :*) port="${after#:}" && port_ok "$port" || return 1 ;;
      *) return 1 ;;
    esac
    # No zone index (%eth0) and at least one colon so this can't smuggle
    # a non-IPv6 host through the literal path.
    [[ "$host" =~ ^[0-9a-fA-F:.]+$ && "$host" == *:* ]] || return 1
    ip_is_public "$host" || return 1
    return 0
  fi
  host="${authority%%:*}"
  if [[ "$authority" == *:* ]]; then
    port="${authority#*:}"
    [[ "$port" != *:* ]] && port_ok "$port" || return 1
  fi
  [[ -n "$host" ]] || return 1
  if [[ "$host" =~ ^[0-9.xX]+$ ]]; then
    # Numeric-looking host: accept only a canonical public dotted quad
    # (ip_is_public enforces the format). Connecting to an IP literal does
    # no DNS lookup, so there is nothing to pin.
    ip_is_public "$host" || return 1
    return 0
  fi
  [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || return 1
  addrs="$(getent ahosts "$host" 2>/dev/null | awk '{ print $1 }' | sort -u)"
  [[ -n "$addrs" ]] || return 1
  while IFS= read -r ip; do
    ip_is_public "$ip" || return 1
    # Prefer an IPv4 pin when both families resolved: it works regardless
    # of whether the local network actually routes IPv6.
    if [[ -z "$pin" || ("$pin" == *:* && "$ip" != *:*) ]]; then
      pin="$ip"
    fi
  done <<<"$addrs"
  if [[ "$pin" == *:* ]]; then
    resolve_opts=(--resolve "${host}:${port}:[${pin}]")
  else
    resolve_opts=(--resolve "${host}:${port}:${pin}")
  fi
  return 0
}

# Validation-only view of url_resolve_pin, kept for the test suite and any
# caller that doesn't go on to fetch. The local shadows the global array so
# a probe never clobbers a pin an in-flight fetch is about to use.
url_is_public() {
  local resolve_opts
  url_resolve_pin "$1"
}

# Final HTTP status code in a curl -D header dump ("HTTP/2 301" and
# HTTP/1.1 forms both; the last status line wins so 100-continue is skipped).
http_code_from() {
  awk 'toupper($1) ~ /^HTTP\// { c = $2 } END { print c + 0 }' "$1"
}

# Last Location header of a response, made absolute. $2 is the request's
# scheme://host[:port], used for protocol-relative and root-relative forms;
# relative-path redirects are rare enough in the wild to treat as a failure.
location_from() {
  local hdr="$1" base="$2" loc
  loc="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$hdr" | tail -1 | tr -d '\r')"
  case "$loc" in
    http://* | https://*) printf '%s' "$loc" ;;
    //*) printf '%s:%s' "${base%%://*}" "$loc" ;;
    /*) printf '%s%s' "$base" "$loc" ;;
    *) ;;
  esac
}

# The test suite sources this file with TSUNDOKU_RESOLVE_LIB=1 to exercise
# the helpers above; nothing below (arg parsing, fetching, output) runs then.
if [[ -n "${TSUNDOKU_RESOLVE_LIB:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

usage() {
  echo "Usage: tsundoku-resolve --thumbs-dir DIR [--oembed ENDPOINT_URL] <url>" >&2
  exit 1
}

thumbs_dir=""
oembed_url=""
url=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --thumbs-dir)
      thumbs_dir="$2"
      shift 2
      ;;
    --oembed)
      oembed_url="$2"
      shift 2
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done

[[ -n "$thumbs_dir" && -n "$url" ]] || usage

# --- entity decoding -------------------------------------------------------

# Decode the fixed set of named entities the spec calls out, then any
# numeric &#NNN; / &#xHH; forms. &amp; is decoded last so it can't eat the
# leading "&" of an entity that itself failed to fully decode above it.
decode_entities() {
  local s="$1"
  s="${s//&lt;/<}"
  s="${s//&gt;/>}"
  s="${s//&quot;/\"}"
  s="${s//&#39;/\'}"
  s="${s//&#x27;/\'}"
  s="${s//&#X27;/\'}"
  s="${s//&nbsp;/ }"
  # The backslash before & is load-bearing: bash's ${var//pat/rep} treats
  # a bare & in the replacement specially (silently no-ops the whole
  # substitution) unless it's escaped.
  s="${s//&amp;/\&}"

  local hex8 char
  # Decimal numeric entities, e.g. &#8217;
  while [[ "$s" =~ \&#([0-9]+)\; ]]; do
    hex8="$(printf '%08x' "${BASH_REMATCH[1]}")"
    # \U needs 8 hex digits directly in the format string — building it via
    # string concat (not a %-spec) is what makes bash's printf treat it as
    # a real unicode escape instead of erroring "missing unicode digit".
    char="$(printf "\\U${hex8}" 2>/dev/null)"
    s="${s/${BASH_REMATCH[0]}/$char}"
  done
  # Hex numeric entities, e.g. &#x2019;
  while [[ "$s" =~ \&#[xX]([0-9a-fA-F]+)\; ]]; do
    hex8="$(printf '%08x' "$((16#${BASH_REMATCH[1]}))")"
    char="$(printf "\\U${hex8}" 2>/dev/null)"
    s="${s/${BASH_REMATCH[0]}/$char}"
  done

  printf '%s' "$s"
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# --- networking --------------------------------------------------------

# Fetches $1 with curl, capped to 256 KiB via `head -c`. Leaves the body in
# $body and curl's real exit code in $fetch_status. This deliberately does
# NOT use `body="$(curl ... | head ...)"` — that form runs the pipeline in
# a subshell, so $PIPESTATUS read afterward belongs to the wrong shell and
# never reflects curl. Routing through a temp file keeps the pipeline (and
# its PIPESTATUS) in this shell so we can tell "curl failed" apart from
# "curl got SIGPIPE because head closed the read end at 256 KiB" (exit 23,
# which we tolerate — it's the size cap working as intended).
# Redirects are followed by hand, up to MAX_REDIRECTS, so that every hop is
# re-vetted and re-pinned with url_resolve_pin — a public page must not be
# able to bounce the fetch into localhost or the LAN, whether by redirect
# target or by DNS rebinding between the check and the transfer.
fetch_capped() {
  local u="$1" hops=0 tmp hdr code loc rest
  body=""
  fetch_status=1
  while :; do
    if ! url_resolve_pin "$u"; then
      body=""
      fetch_status=22
      return
    fi
    tmp="$(mktemp)"
    hdr="$(mktemp)"
    curl "${CURL_OPTS[@]}" "${resolve_opts[@]}" -D "$hdr" "$u" 2>/dev/null | head -c 262144 >"$tmp"
    fetch_status=${PIPESTATUS[0]}
    code="$(http_code_from "$hdr")"
    case "$code" in
      301 | 302 | 303 | 307 | 308)
        rest="${u#*://}"
        loc="$(location_from "$hdr" "${u%%://*}://${rest%%/*}")"
        rm -f "$tmp" "$hdr"
        if [[ -n "$loc" && $hops -lt $MAX_REDIRECTS ]]; then
          u="$loc"
          hops=$((hops + 1))
          continue
        fi
        body=""
        fetch_status=47 # curl's own too-many-redirects code
        return
        ;;
    esac
    body="$(cat "$tmp")"
    rm -f "$tmp" "$hdr"
    return
  done
}

# --- OpenGraph extraction -----------------------------------------------

# Pulls content="..." out of <meta property="$2" content="..."> in either
# attribute order and either quote style. Two passes, property-then-content
# and content-then-property; whichever the page actually used wins.
get_meta() {
  local html="$1" key="$2" val
  val="$(printf '%s' "$html" | grep -ioP "<meta\b[^>]*\bproperty=[\"']${key}[\"'][^>]*\bcontent=[\"']\K[^\"']*" | head -1)"
  if [[ -z "$val" ]]; then
    val="$(printf '%s' "$html" | grep -ioP "<meta\b[^>]*\bcontent=[\"']\K[^\"']*(?=[^>]*\bproperty=[\"']${key}[\"'])" | head -1)"
  fi
  printf '%s' "$val"
}

# Protocol-relative (//host/img) becomes https:, root-relative (/img)
# resolves against the page's own scheme+host, anything else is passed
# through as-is (already absolute, or a relative form we don't special-case).
resolve_image_url() {
  local img="$1"
  case "$img" in
    //*) printf 'https:%s' "$img" ;;
    /*) printf '%s%s' "$page_base" "$img" ;;
    *) printf '%s' "$img" ;;
  esac
}

# --- thumbnail caching ---------------------------------------------------

# Downloads $1 into $2/<sha256 of the URL>.<ext>, skipping the fetch entirely
# if that file already exists and is non-empty (cache hit). Prints the dest
# path and returns 0 on success (including a cache hit); on any failure
# removes the partial file and returns 1.
download_thumbnail() {
  local thumb_url="$1" dir="$2"
  mkdir -p "$dir" 2>/dev/null

  local hash path_no_query no_scheme path_only ext_candidate ext dest
  hash="$(printf '%s' "$thumb_url" | sha256sum | cut -d' ' -f1)"

  path_no_query="${thumb_url%%[?#]*}"
  no_scheme="${path_no_query#*://}"
  path_only="${no_scheme#*/}"
  ext_candidate=""
  # Only look for an extension if there was an actual path segment past the
  # host — otherwise "${path_only##*.}" would fall back to a dot in the
  # hostname itself (e.g. "example.com") and misread that as an extension.
  if [[ "$path_only" != "$no_scheme" ]]; then
    ext_candidate="${path_only##*.}"
    ext_candidate="$(printf '%s' "$ext_candidate" | tr '[:upper:]' '[:lower:]')"
  fi
  case "$ext_candidate" in
    jpg | jpeg | png | webp | gif) ext="$ext_candidate" ;;
    *) ext="jpg" ;;
  esac

  dest="$dir/$hash.$ext"
  # A symlink at the cache path is never trusted as a hit, and the download
  # lands in a fresh mktemp file that is renamed over dest afterward — curl
  # never writes through a pre-existing path. Redirects are followed by hand
  # with url_resolve_pin re-vetting and re-pinning per hop, same as
  # fetch_capped.
  if [[ -s "$dest" && ! -L "$dest" ]]; then
    printf '%s' "$dest"
    return 0
  fi

  local u="$thumb_url" hops=0 tmp hdr code loc rest
  tmp="$(mktemp -p "$dir")" || return 1
  while :; do
    if ! url_resolve_pin "$u"; then
      rm -f "$tmp"
      return 1
    fi
    hdr="$(mktemp)"
    if ! curl "${CURL_OPTS[@]}" "${resolve_opts[@]}" --max-filesize 5242880 -D "$hdr" -o "$tmp" "$u" 2>/dev/null; then
      rm -f "$tmp" "$hdr"
      return 1
    fi
    code="$(http_code_from "$hdr")"
    case "$code" in
      301 | 302 | 303 | 307 | 308)
        rest="${u#*://}"
        loc="$(location_from "$hdr" "${u%%://*}://${rest%%/*}")"
        rm -f "$hdr"
        if [[ -n "$loc" && $hops -lt $MAX_REDIRECTS ]]; then
          u="$loc"
          hops=$((hops + 1))
          continue
        fi
        rm -f "$tmp"
        return 1
        ;;
    esac
    rm -f "$hdr"
    break
  done

  if [[ -s "$tmp" ]] && mv -f "$tmp" "$dest" 2>/dev/null; then
    printf '%s' "$dest"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Same host recipe as the bare tier below: strip scheme, path, userinfo,
# port, and a leading www.
url_host() {
  local h="$1"
  h="${h#*://}"
  h="${h%%[/?#]*}"
  h="${h##*@}"
  h="${h%%:*}"
  h="${h#www.}"
  printf '%s' "$h"
}

# --- resolution tiers ------------------------------------------------------

title=""
author=""
description=""
siteName=""
thumb_source_url=""

# Tier 1: oEmbed. Only the plain metadata fields are ever read — the
# spec's `html` embed field is never touched.
resolve_oembed() {
  fetch_capped "$oembed_url"
  if [[ $fetch_status -ne 0 && $fetch_status -ne 23 ]]; then
    return 1
  fi
  [[ -z "$body" ]] && return 1
  jq -e . >/dev/null 2>&1 <<<"$body" || return 1

  local raw_title raw_author raw_thumb
  raw_title="$(jq -r '.title // empty' <<<"$body" 2>/dev/null)"
  [[ -z "$raw_title" ]] && return 1
  raw_author="$(jq -r '.author_name // empty' <<<"$body" 2>/dev/null)"
  raw_thumb="$(jq -r '.thumbnail_url // empty' <<<"$body" 2>/dev/null)"

  title="$(trim "$raw_title")"
  author="$(trim "$raw_author")"
  thumb_source_url="$raw_thumb"
  return 0
}

# Tier 2: OpenGraph / meta-tag scraping of the page itself.
resolve_opengraph() {
  fetch_capped "$url"
  if [[ $fetch_status -ne 0 && $fetch_status -ne 23 ]]; then
    return 1
  fi
  [[ -z "$body" ]] && return 1

  # Flatten to one line first: pretty-printed HTML can split a <meta ...>
  # tag's attributes across lines, and grep -P's default mode is per-line.
  local flat
  flat="$(printf '%s' "$body" | tr '\n\r' '  ')"

  local og_title og_image og_desc og_site article_author
  og_title="$(get_meta "$flat" "og:title")"
  og_image="$(get_meta "$flat" "og:image")"
  og_desc="$(get_meta "$flat" "og:description")"
  og_site="$(get_meta "$flat" "og:site_name")"
  article_author="$(get_meta "$flat" "article:author")"

  if [[ -z "$og_title" ]]; then
    og_title="$(printf '%s' "$flat" | grep -ioP '(?<=<title>).*?(?=</title>)' | head -1)"
  fi
  [[ -z "$og_title" ]] && return 1

  title="$(trim "$(decode_entities "$og_title")")"
  author="$(trim "$(decode_entities "$article_author")")"
  description="$(trim "$(decode_entities "$og_desc")")"
  siteName="$(trim "$(decode_entities "$og_site")")"

  if [[ -n "$og_image" ]]; then
    # URLs can legitimately contain HTML-entity-escaped query strings
    # (e.g. Wikimedia's "...?utm_source=x&amp;utm_campaign=y"), so decode
    # before this is ever handed to curl.
    thumb_source_url="$(resolve_image_url "$(decode_entities "$og_image")")"
  fi
  return 0
}

# scheme://host of the page URL, used to resolve root-relative og:image URLs.
scheme="${url%%://*}"
host_and_rest="${url#*://}"
host_only="${host_and_rest%%/*}"
page_base="$scheme://$host_only"

# Same host recipe as url_host(), computed once up front for the bare
# tier — tsundoku-add uses this recipe too, for its notification toast.
page_host="$(url_host "$url")"

if [[ -n "$oembed_url" ]] && resolve_oembed; then
  tier="oembed"
  status="resolved"
elif resolve_opengraph; then
  tier="opengraph"
  status="resolved"
else
  tier="bare"
  status="bare"
  title="$page_host"
fi

thumbnailPath=""
if [[ -n "$thumb_source_url" ]]; then
  if dest="$(download_thumbnail "$thumb_source_url" "$thumbs_dir")"; then
    thumbnailPath="$dest"
  fi
fi

jq -nc \
  --arg status "$status" \
  --arg tier "$tier" \
  --arg title "$title" \
  --arg author "$author" \
  --arg description "$description" \
  --arg siteName "$siteName" \
  --arg thumbnailPath "$thumbnailPath" \
  '{status: $status, tier: $tier, title: $title, author: $author, description: $description, siteName: $siteName, thumbnailPath: $thumbnailPath}'

exit 0
